model Model
	culture: sk-SK
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Kategoria","Zakaznici","Datum","DetailObjednavok","Objednavky","Produkty"]

annotation PBI_ProTooling = ["DevMode"]

ref table Kategoria
ref table Zakaznici
ref table Datum
ref table DetailObjednavok
ref table Objednavky
ref table Produkty

ref cultureInfo sk-SK

